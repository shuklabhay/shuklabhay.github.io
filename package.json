{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "setup": "pnpm install --frozen-lockfile",
    "dev": "vite --host",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && vite build --ssr scripts/prerender.ts --outDir dist-prerender && node dist-prerender/prerender.js && cp -R one-off-portfolios/. dist/",
    "preview": "vite preview",
    "lint": "prettier ./ --write",
    "format-check": "prettier ./ --check"
  },
  "dependencies": {
    "katex": "^0.16.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "react-spring-lightbox": "^1.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@mdx-js/rollup": "^3.1.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "postcss": "^8.4.41",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.8.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.0.1",
    "vite": "^6.4.1"
  },
  "pnpm": {
    "overrides": {
      "react-use-gesture": "^9.1.3"
    }
  }
}
